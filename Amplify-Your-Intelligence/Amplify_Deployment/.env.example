# Copy this file to .env and replace every placeholder before running .\up.ps1.
# Keep AZURE_CLIENT_SECRET local. Never commit a populated .env file.
AZURE_SUBSCRIPTION_ID=<YOUR_SUBSCRIPTION_ID>
AZURE_TENANT_ID=<YOUR_TENANT_ID>
AZURE_CLIENT_ID=<YOUR_SERVICE_PRINCIPAL_CLIENT_ID>
AZURE_CLIENT_SECRET=<YOUR_SERVICE_PRINCIPAL_CLIENT_SECRET>

# Amplify IQ uses West US 2 for the resource group and Fabric capacity.
AZURE_LOCATION=westus2

# The Fabric capacity administrator. This UPN and the deployment service principal
# are both added as capacity administrators.
FABRIC_CAPACITY_ADMIN_UPN=<YOUR_FABRIC_ADMIN_UPN>

# The <ID> portion of the README capacity name: fabriccapacity<ID>.
# Use lowercase letters and numbers only, for example: 001 or workshop01.
FABRIC_CAPACITY_ID=<YOUR_CAPACITY_ID>
