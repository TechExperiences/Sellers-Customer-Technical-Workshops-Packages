          "sqlDatabaseName": {
            "value": "[parameters('sqlDatabaseName')]"
          },
          "fabricCapacityName": {
            "value": "[parameters('fabricCapacityName')]"
          },
          "fabricCapacityLocation": {
            "value": "westus2"
          },
          "fabricCapacityAdministrators": {
            "value": "[union(parameters('fabricCapacityAdministrators'), createArray())]"
          },
          "deploymentPrincipalObjectId": {
            "value": "[parameters('deploymentPrincipalObjectId')]"
          },
          "deploymentPrincipalType": {
            "value": "[parameters('deploymentPrincipalType')]"
          }
        },
        "template": {
